# NEXORA Backend Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# Optional: LLM API for AI mission briefs (Phase 2 bonus feature)
# Leave empty to use templated briefs instead
ANTHROPIC_API_KEY=your_key_here

# Optional: Space-Track.org credentials (if using instead of CelesTrak)
# SPACE_TRACK_USERNAME=your_username
# SPACE_TRACK_PASSWORD=your_password

# Cache settings
TLE_CACHE_TTL_HOURS=6

# API settings
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
